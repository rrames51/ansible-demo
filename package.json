{
  "name": "ansible-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tech demo: Ansible deploys a Node+Express app to bare metal, tested via LXC.",
  "scripts": {
    "app:start": "node app/server.js",
    "inttest": "node scripts/inttest.ts",
    "inttest:self": "node scripts/self.ts",
    "test:http": "node scripts/test-http-run.ts",
    "check:ts": "tsc --noEmit",
    "ensure:lxd": "node scripts/ensure-lxd.ts"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
